# RepoMind Frontend Environment Configuration (Vercel / Vite)

# Backend API base URL for RepoMind
# In local development: http://localhost:8000/api/v1 (or leave blank to use the Vite /api proxy)
# In production on Vercel: https://repomind-backend.onrender.com/api/v1 (or your custom backend domain)
VITE_API_BASE_URL=https://repomind-backend.onrender.com/api/v1

# Optional Application Metadata
VITE_APP_NAME=RepoMind
VITE_APP_VERSION=0.1.0
