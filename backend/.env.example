# Application Configuration
APP_NAME=RepoMind
APP_ENV=development
DEBUG=true
PORT=8000
HOST=127.0.0.1

# URLs & CORS
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database Configuration
# For PostgreSQL with asyncpg:
# DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/repomind
# For local development / SQLite fallback:
DATABASE_URL=sqlite+aiosqlite:///./repomind.db
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Security & JWT Configuration
JWT_SECRET=replace-this-with-a-secure-random-secret-key-at-least-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Logging
LOG_LEVEL=INFO
