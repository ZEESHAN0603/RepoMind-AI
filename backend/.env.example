# Application Configuration
APP_NAME=RepoMind
APP_ENV=development
DEBUG=true
PORT=8000
HOST=127.0.0.1

# URLs & CORS
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database Configuration — Supabase Managed PostgreSQL (Authoritative Application Database)
# Supabase Managed PostgreSQL (Session Mode on Port 5432 - Recommended for Render):
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?ssl=require
#
# Supabase Managed PostgreSQL (Transaction Pooler on Port 6543 / Supavisor):
# DATABASE_URL=postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?ssl=require

DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Supabase API & Project Configuration (Backend Only)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Security & JWT Configuration
JWT_SECRET=replace-this-with-a-secure-random-secret-key-at-least-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Logging
LOG_LEVEL=INFO

# AI & LLM Provider Configuration (Phase 5)
AI_PRIMARY_PROVIDER=ollama
AI_FALLBACK_PROVIDER=gemini

# Ollama Configuration (Local development default)
OLLAMA_BASE_URL=http://localhost:11434
PRODUCTION_OLLAMA_BASE_URL=https://11434-agq6j3olyzqnjz6i3vl5zgyvj4.instabox.tech
OLLAMA_CHAT_ENDPOINT=/api/chat
OLLAMA_EMBED_ENDPOINT=/api/embed
OLLAMA_PORT=11434
OLLAMA_AUTH_REQUIRED=true
OLLAMA_ACCESS_TOKEN=your_instabox_private_port_token_here
OLLAMA_GENERATION_MODEL=qwen3.5:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CONTEXT_WINDOW=4096
OLLAMA_TIMEOUT_SECONDS=60.0

# Gemini Free-Tier Fallback Configuration
GEMINI_API_KEY= your-gcp-api-key-here
GEMINI_MODEL=gemini 3.8 Flash
GEMINI_ALLOW_CLOUD_FALLBACK=true
